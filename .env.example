# AEGIS configuration. Copy to .env. Secrets belong here or in a secret manager, never in frontend source or ZIPs.
PORT=4173
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
# SQLite store for cache, archived forecast runs, scenarios, subscriptions, advisories, audit log.
AEGIS_DB_PATH=data/aegis.sqlite
# Maps: MapLibre GL JS is self-hosted and the basemaps (OpenFreeMap, Esri imagery, AWS terrain) need no key.
# Comma-separated browser origins allowed to call the API cross-origin (empty = same-origin only).
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
OUTBOUND_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=600
# NASA Earthdata bearer token for SMAP L4 retrieval (scripts/ingest-smap.py). Discovery works without it.
EARTHDATA_TOKEN=
# Google WeatherNext 3 approved access path: none | gcs | bigquery | earth-engine. Requires an approved project.
WEATHERNEXT_ACCESS_MODE=none
WEATHERNEXT_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Notifications stay disabled. A provider adapter does not exist in this repository.
NOTIFICATION_PROVIDER=none
NOTIFICATION_SENDS_ENABLED=false
# Bearer key that an authorised officer uses to approve or cancel advisories. Leave empty to disable approval.
ADVISORY_AUTHORITY_KEY=
# Bearer key for the audit log route.
ADMIN_API_KEY=
TRUST_PROXY=false
